# ── Sanity Project ───────────────────────────────────────────────────────────
# Create a free project at https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# ── Sanity API Token ──────────────────────────────────────────────────────────
# Create at https://sanity.io/manage → API → Tokens → Add API token
# Minimum permissions: Editor (for Studio writes), Viewer (for reads)
SANITY_API_TOKEN=your_api_token_here
